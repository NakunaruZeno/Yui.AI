{
  "manifest_version": 3,
  "name": "Yui.AI — Multi-AI Assistant",
  "version": "1.1.0",
  "description": "Minimalist SAO Cardinal Workspace — Manage ChatGPT, Claude, and Gemini concurrently with High-DPI Screen Capture & All-Link Auto-Submit.",
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },

  "action": {
    "default_popup": "ui/views/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    },
    "default_title": "Yui.AI — Cardinal Interface"
  },

  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },

  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "declarativeNetRequest",
    "storage"
  ],

  "host_permissions": [
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*"
  ],

  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "yui_bypass_rules",
        "enabled": true,
        "path": "src/config/rules.json"
      }
    ]
  },

  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "js": ["src/content/content-inject.js"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "js": ["src/content/content-main-world.js"],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],

  "commands": {
    "capture-and-send": {
      "suggested_key": {
        "default": "Ctrl+Shift+X",
        "mac": "Command+Shift+X"
      },
      "description": "Capture screen & send to AI"
    },
    "open-dashboard": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Open Yui.AI Dashboard"
    }
  }
}
